--- a/drivers/gpu/drm/panel/panel-cwu50.c
+++ b/drivers/gpu/drm/panel/panel-cwu50.c
@@ -635,6 +635,23 @@ static int cwu50_prepare(struct drm_panel *panel)
 	}
 	/* Exit sleep mode and power on */
+
+	/*
+	 * Without a panel ID GPIO (e.g. on CM5 where the RESX pin isn't
+	 * connected), detect panel type by reading the panel's chip ID
+	 * register over DSI.  Wake the panel first (SLPOUT) so DCS reads
+	 * work.  Since we already woke the panel, the normal
+	 * exit_sleep_mode() path is skipped via the ctx->id_gpio
+	 * guard below.
+	 */
+	if (!ctx->id_gpio) {
+		u8 buf[1] = { };
+		dcs_write_seq(0x11);  /* SLPOUT -- wake for DCS read */
+		msleep(120);
+		dcs_write_seq(0xE0, 0x00);
+		if (mipi_dsi_dcs_read(dsi, 0x04, buf, 1) == 1 && buf[0] == 0x39)
+			ctx->is_new_panel = true;
+	}
+
 	if (ctx->is_new_panel)
 		cwu50_init_sequence2(ctx);
 	else
@@ -641,8 +657,10 @@ static int cwu50_prepare(struct drm_panel *panel)
 	else
 		cwu50_init_sequence(ctx);
 
-	ret = mipi_dsi_dcs_exit_sleep_mode(dsi);
-	if (ret) {
-		dev_err(ctx->dev, "failed to exit sleep mode (%d)\n", ret);
-		return ret;
-	}
-	msleep(120);
+	if (ctx->id_gpio) {
+		ret = mipi_dsi_dcs_exit_sleep_mode(dsi);
+		if (ret) {
+			dev_err(ctx->dev, "failed to exit sleep mode (%d)\n", ret);
+			return ret;
+		}
+		msleep(120);
+	}
 
 	ret = mipi_dsi_dcs_set_display_on(dsi);
@@ -733,22 +751,46 @@ static int cwu50_probe(struct mipi_dsi_device *dsi)
 		return ret;
 	}

-	ctx->is_new_panel = gpiod_get_value_cansleep(ctx->id_gpio);
-	if (ctx->is_new_panel) {
-		dev_info(dev, "Detected new panel type\n");
-	} else {
-		dev_info(dev, "Detected old panel type\n");
-	}

-	/*
-	 * Switch the ID GPIO to OUTPUT for use with resetting,
-	 * only if we're using the old panel. The new panel's
-	 * ID (RESX) pin is always pulled down (or: asserted)
-	 * externally.
-	 */
-	if (!ctx->is_new_panel) {
-		dev_info(dev, "Old panel type, setting ID GPIO to OUTPUT for resetting\n");
-		ret = gpiod_direction_output(ctx->id_gpio, 0);
+	/*
+	 * Detect panel type via ID GPIO if available.
+	 *
+	 * On older uConsole hardware (CM4) the RESX pin doubles
+	 * as a panel-ID strapping pin at boot: a pull-up resistor
+	 * signals "new panel" (init_sequence2), pull-down (or the
+	 * pin being driven low) signals "old panel" (init_sequence1).
+	 *
+	 * On CM5 hardware the RESX pin is not connected to a GPIO
+	 * on the SoC -- devm_gpiod_get_optional returns NULL above.
+	 * In that case we leave is_new_panel = 0 (the kzalloc
+	 * default) and detect the panel type later via DCS register
+	 * read in prepare().
+	 */
+	if (ctx->id_gpio) {
+		ctx->is_new_panel = gpiod_get_value_cansleep(ctx->id_gpio);
+		if (ctx->is_new_panel)
+			dev_info(dev, "GPIO: new panel\n");
+		else
+			dev_info(dev, "GPIO: old panel\n");
+	} else {
+		dev_info(dev, "no panel ID GPIO -- will detect via DCS\n");
+	}

+	/*
+	 * Switch the ID GPIO to OUTPUT for use with resetting,
+	 * only if we're using the old panel and the GPIO exists.
+	 * The new panel's ID (RESX) pin is always pulled down
+	 * (or: asserted) externally.
+	 */
+	if (ctx->id_gpio && !ctx->is_new_panel) {
+		dev_info(dev, "Old panel type, setting ID GPIO to OUTPUT for resetting\n");
+		ret = gpiod_direction_output(ctx->id_gpio, 0);
+
 		if (ret) {
 			dev_err(dev, "failed to set id_gpio to OUTPUT\n");
 			return ret;
 		}
 	}
+
+	/*
+	 * Request vci and iovcc regulators when they are defined
+	 */
